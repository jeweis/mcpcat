{
  "name": "@jeweis/mcpcat",
  "version": "0.1.0",
  "description": "Public CLI for mcpcat Skills Registry",
  "type": "module",
  "bin": {
    "mcpcat": "dist/bin.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.19.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jeweis/mcpcat.git",
    "directory": "cli"
  },
  "license": "MIT",
  "optionalDependencies": {
    "@napi-rs/keyring": "^1.3.0"
  },
  "dependencies": {
    "yaml": "^2.8.2",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/yauzl": "^2.10.3",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.0.14"
  }
}
