# 应用配置
APP_NAME=mcpcat
APP_VERSION=0.1.1

# 服务器配置
HOST=0.0.0.0
PORT=8000

# 持久化路径（Docker 中均位于现有 /app/.mcpcat volume 内）
MCPCAT_CONFIG_PATH=.mcpcat/config.json
MCPCAT_DATABASE_PATH=.mcpcat/mcpcat.db
MCPCAT_ARTIFACTS_PATH=.mcpcat/skills/artifacts
MCPCAT_BACKUPS_PATH=.mcpcat/backups
MCPCAT_SQLITE_BUSY_TIMEOUT_MS=5000
MCPCAT_LEGACY_MIGRATION_LOCK_TIMEOUT_SEC=30
MCPCAT_SKILL_ZIP_MAX_BYTES=20971520
MCPCAT_SKILL_EXPANDED_MAX_BYTES=104857600
MCPCAT_SKILL_FILE_MAX_BYTES=10485760
MCPCAT_SKILL_MAX_FILES=1000
MCPCAT_MCP_SKILL_MAX_TOOLS=500
MCPCAT_SKILLS_ENABLED=true

# 日志配置
LOG_LEVEL=INFO

# 默认 API Key 配置（可选，不设置则系统自动生成随机值）
# MCPCAT_DEFAULT_ADMIN_KEY=your-admin-key-here
# MCPCAT_DEFAULT_READ_KEY=your-read-key-here

# 全局加密密钥（可选，用于加密飞书 app_secret 等敏感配置；不设置则系统自动生成并持久化到 SQLite，
# 仅起到混淆作用，生产环境建议显式设置一个随机字符串以获得更明确的安全边界）
# MCPCAT_SECRET_KEY=your-random-secret-key-here
