# 应用配置
APP_NAME=mcpcat
APP_VERSION=0.1.1

# 服务器配置
HOST=0.0.0.0
PORT=8000

# 日志配置
LOG_LEVEL=INFO

# 默认 API Key 配置（可选，不设置则系统自动生成随机值）
# MCPCAT_DEFAULT_ADMIN_KEY=your-admin-key-here
# MCPCAT_DEFAULT_READ_KEY=your-read-key-here

# 全局加密密钥（可选，用于加密飞书 app_secret 等敏感配置；不设置则系统自动生成并持久化到 config.json，
# 仅起到混淆作用，生产环境建议显式设置一个随机字符串以获得真正的安全边界）
# MCPCAT_SECRET_KEY=your-random-secret-key-here
